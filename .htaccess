Options -MultiViews

RewriteEngine On
RewriteBase /

# BEGIN FF CANONICAL HOST (2026-11-09) - one site: www -> non-www (301)
RewriteCond %{HTTP_HOST} ^www\.familyandflats\.com$ [NC]
RewriteRule ^(.*)$ https://familyandflats.com/$1 [R=301,L]
# END FF CANONICAL HOST

# BEGIN FF BACKUP GUARD (2026-11-08) - never serve working backups to visitors or Google
RewriteRule (^|/)_(backup|archive|reports|source_material|to_delete)[^/]*(/|$) - [R=404,L]
RewriteRule \.(bak|orig)(_[^/]*)?$ - [R=404,L]
# END FF BACKUP GUARD

# BEGIN FF FPUP CANONICAL PHP GATEWAY
# Canonical Family&Flats application paths -> PHP gateway -> Render origin. Account/mobile routing synced 2026-09-27.
# Public website routes remain on cPanel.
RewriteRule ^(?:_next|access-denied|access|account|agent|ai-operating-model|ai-organization|architecture-audit|architecture-truth|auth|business-control-autopilot|chief-of-staff|client-property|client|communication-autopilot|dashboard|data-foundation|data-readiness|employee|enterprise-direction|enterprise-intelligence|execution-centre|field|field-admin|founder|founder-command|governance|integration-readiness|inventory-autopilot|journey|login|mission-control|operating-systems|operational-adoption|operations-documentation-autopilot|os|owner|platform-control|post-property|post-requirement|production-platform|property-submission|release-assurance|revenue-engine|security-access|verify-whatsapp|website-publication|workflow-validation|workspace)(?:/.*)?$ _ff_fpup_gateway/index.php [L]
RewriteRule ^api/(?:account|auth|property-intake|field-media|local-auth|health|publication|employee|integrations)(?:/.*)?$ _ff_fpup_gateway/index.php [L]
# END FF FPUP CANONICAL PHP GATEWAY

# Website Enquiry & CRM Unification V1 - canonical thank-you route
RewriteRule ^thank-you\.php$ /thank-you/ [R=301,L]
RewriteRule ^projects/[^/]+/thank-you\.php$ /thank-you/ [R=301,L]


# Phase 4A URL governance aliases
RewriteRule ^projects/ireovictoryvalley/?$ /projects/ireo-victory-valley/ [R=301,L]
RewriteRule ^projects/detail\.html$ /projects/ireo-skyon/ [R=301,L]
RewriteRule ^project\.html$ /projects/ireo-skyon/ [R=301,L]
RewriteRule ^project-detail\.html$ /projects/ireo-skyon/ [R=301,L]

# Mahindra Luminare canonical project URL
RewriteRule ^projects/mahindraluminare/?$ /projects/mahindra-luminare/ [R=301,L]

# Duplicate project folders -> canonical project pages (2026-11-09)
RewriteRule ^projects/ireoskyon(/.*)?$ /projects/ireo-skyon/ [R=301,L]
RewriteRule ^projects/victoryvalley(/.*)?$ /projects/ireo-victory-valley/ [R=301,L]
RewriteRule ^projects/regrandarch(/.*)?$ /projects/ireograndarch/ [R=301,L]
RewriteRule ^projects/re-conscienthineselevate(/.*)?$ /projects/conscienthineselevate/ [R=301,L]
RewriteRule ^projects/emaar-digi-?homes(/.*)?$ /projects/emaardigihomes/ [R=301,L]

# Old blog URLs to new blog folder
RedirectMatch 301 ^/blog-(.*)\.html$ /content/blogs/blog-$1.html

# Old news URLs to new news folder
RedirectMatch 301 ^/news-(.*)\.html$ /content/news/news-$1.html

# Clean blog URLs: /blog-109
RewriteRule ^content/blogs/blog-106\.html$ /content/blogs/blog-105.html [R=301,L]
RewriteRule ^content/blogs/blog-108\.html$ /content/blogs/blog-105.html [R=301,L]
RewriteRule ^content/blogs/blog-113\.html$ /content/blogs/blog-105.html [R=301,L]
RewriteRule ^content/blogs/blog-95\.html$ /content/blogs/blog-60.html [R=301,L]
RewriteRule ^content/news/news-14-07-2025\.html$ /content/news/news-19-07-2025.html [R=301,L]
RewriteRule ^content/news/news-23-08-2025\.html$ /content/news/news-21-08-2025.html [R=301,L]
RewriteRule ^blog-([0-9A-Za-z-]+)$ /content/blogs/blog-$1.html [L]

# Clean news URLs: /news-12
RewriteRule ^news-([0-9A-Za-z-]+)$ /content/news/news-$1.html [L]

<IfModule mod_headers.c>
  # Pages, CSS and JS: browser must re-check every visit, so updates show at once (2026-11-09)
  <FilesMatch "\.(html|htm|js|css|json|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # App gateway (logged-in founder/employee pages): never stored
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  # Images, video and fonts: cache for 1 day (replaced photos get new file names)
  <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico|mp4|webm|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
# Family&Flats service detail redirects
RewriteRule ^After-Sales-Services\.html$ services/after-sales-services.html [R=301,L]
RewriteRule ^Buying-Property\.html$ services/buying-property.html [R=301,L]
RewriteRule ^Selling-Property\.html$ services/selling-property.html [R=301,L]
RewriteRule ^Mortgage-Service\.html$ services/mortgage-service.html [R=301,L]
RewriteRule ^Exclusivity\.html$ services/exclusivity.html [R=301,L]
